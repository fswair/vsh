# Copy to .env and fill in your values.
MODEL_NAME=openrouter:anthropic/claude-sonnet-4
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional vsh persistence
# VSH_DATA_DIR=~/.vsh
# VSH_PERSIST=1

# Optional CodeMode MCP custom instructions
# VSH_CODEMODE_INSTRUCTIONS=Prefer vsh_rg over vsh_grep.
# VSH_CODEMODE_INSTRUCTIONS_FILE=.vsh/codemode-instructions.md
